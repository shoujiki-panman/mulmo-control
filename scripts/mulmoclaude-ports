#!/bin/zsh
set -u

# そのモードで MulmoClaude が待つポート（Issue #168）。
#
# 通常モードでは Vite が立たないので 5173 は開かない。ここを見落とすと
# 「起動したのに動作していないと出る」「開くボタンが白い画面を出す」に
# なる（Issue #91 / #93 で踏んだのと同じ形）。
#
# 対応表を持つのはこのスクリプトと Sources/main.swift の
# MulmoClaudeMode だけ。2つあるのは Swift から毎回シェルを起こしたくない
# ためで、食い違わないことは check.sh が突き合わせて見ている。

# 検査だけが使う抜け道（Issue #172）。check.sh は、起こし直す親を持つ偽の木を
# 立てて **本物の `mulmoclaude-stop` を当てる**。そのために、見るポートを差し
# 替えられる必要がある。実行時にこれを設定するものは無い。
if [ -n "${MULMO_TEST_PORTS:-}" ]; then
  if [ "${1:-}" = "--api" ]; then
    printf '%s\n' ${=MULMO_TEST_PORTS} | /usr/bin/tail -1
  else
    printf '%s\n' ${=MULMO_TEST_PORTS}
  fi
  exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MODE="$("${SCRIPT_DIR}/mulmoclaude-mode")"

ports() {
  case "${MODE}" in
    app) printf '3001\n' ;;
    *) printf '5173\n3001\n' ;;
  esac
}

# バックエンド（API）のポート（Issue #187）。Telegram ブリッジの接続先はここで、
# 開発モードでも変わらない。表をもう1つ持つと必ず食い違うので、上の表の
# 最後の行を読む — 開発モードで増えるのは前に付く Vite のほうだけ。
if [ "${1:-}" = "--api" ]; then
  # 動いているなら、実際に待っているポート（Issue #190）。ブリッジの接続先が
  # ここで決まるので、3002 へ逃げていたら繋がらないまま「立てました」になる。
  LIVE="$("${SCRIPT_DIR}/mulmoclaude-live-ports" 2>/dev/null | /usr/bin/awk -F'\t' '$1 == "api" { print $2; exit }')"
  if [ -n "${LIVE}" ]; then
    printf '%s\n' "${LIVE}"
  else
    ports | /usr/bin/tail -1
  fi
  exit 0
fi

ports

#!/bin/zsh
set -u

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# 兄弟スクリプトは自分と同じディレクトリから呼ぶ（Issue #11）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# 設定は shell として実行せず、許可したキーの値だけを読む（Issue #67）。
# `. "${CONFIG}"` だと、設定ファイルに紛れた `touch ...` や `$(...)` が
# 読んだ側の権限でそのまま走る。
APP_DIR="$("${SCRIPT_DIR}/mulmo-config-get" MULMO_CONTROL_MULMOCLAUDE_DIR)"
APP_DIR="${APP_DIR:-${HOME}/mulmoclaude}"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
OUT_LOG="${LOG_DIR}/mulmoclaude.log"
ERR_LOG="${LOG_DIR}/mulmoclaude-error.log"

mkdir -p "${LOG_DIR}"

# 「もう動いている」と言ってよいのは、設定の MulmoClaude が動いているときだけ
# （Issue #91）。以前はポートが埋まっているだけで引き返していたので、他の
# プロジェクトが 5173 を持っていると、起動を押しても何も起きなかった。
if [ -n "$("${SCRIPT_DIR}/mulmoclaude-pids")" ]; then
  echo "MulmoClaude: already running"
  exit 0
fi

# ポートを他人が持っている場合は、起動しても vite が取れずに落ちる。
# 何が起きたか分からないまま終わらせないよう、理由を残す。
OTHERS="$("${SCRIPT_DIR}/mulmoclaude-pids" --others | /usr/bin/xargs 2>/dev/null || true)"
if [ -n "${OTHERS}" ]; then
  echo "MulmoClaude: 5173 か 3001 を別のものが使っています（pid ${OTHERS}）。そちらを止めてから起動してください" | /usr/bin/tee -a "${ERR_LOG}"
  exit 1
fi

cd "${APP_DIR}"
echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] starting MulmoClaude" >>"${OUT_LOG}"
YARN="$(command -v yarn || true)"
if [ -z "${YARN}" ]; then
  echo "yarn was not found" >>"${ERR_LOG}"
  exit 1
fi
# PORT は渡さない（#141）。
#
# MulmoClaude のバックエンドは PORT を読む。Mulmo Control 自身が MulmoTerminal
# のセルの中から起動されていると PORT=34567（MulmoTerminal のポート）を持って
# いて、それがここから yarn dev まで素通りする。バックエンドは MulmoTerminal の
# ポートを奪おうとして5回落ち、concurrently -k が vite を道連れにする。
#
# 見つけにくいのは、その間 5173 だけが数秒立つこと。生存判定は 5173 を見ている
# ので「動作中」と出て、ブラウザにもページが出る。中身が空なだけで、直ったように
# 見える。mulmoclaude-pids も 5173 と 3001 しか見ないので、34567 で溺れている
# バックエンドは最初から居ないものとして扱われる。
#
# ここは MulmoClaude をサービスとして起こす場所で、呼び出し元シェルの続きでは
# ない。どのポートで待つかは MulmoClaude の .env と既定が決める。
if [ -n "${PORT:-}" ]; then
  echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] 引き継いだ PORT=${PORT} を外して起動します" >>"${OUT_LOG}"
fi
nohup /usr/bin/env -u PORT "${YARN}" dev >>"${OUT_LOG}" 2>>"${ERR_LOG}" &

sleep 2
# ブラウザを開くかどうかはアプリ側が決める（`開く` だけが開く）。
# ここで開くと `開く` は二重に開き、`起動` と `再起動` は開かないつもりなのに
# 開いてしまう。mulmoterminal-start と同じく、このスクリプトは開かない。
echo "MulmoClaude: started"

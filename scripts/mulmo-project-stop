#!/bin/zsh
set -u

# 立てたリモートセッションを止める（Issue #152）。
#
#   使い方: mulmo-project-stop <プロジェクト名>
#
# 止めるのは **Mulmo Control が立てたものだけ**。同じフォルダで人が手で開いた
# セッションまで巻き込むと、作業中のものが消える。控えた pid のものだけ落とす。

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
LOG="${LOG_DIR}/projects.log"
STATE_DIR="${LOG_DIR}/project-sessions"

NAME="${1:-}"
mkdir -p "${LOG_DIR}" "${STATE_DIR}"

if [ -z "${NAME}" ]; then
  echo "プロジェクト名を渡してください" | tee -a "${LOG}"
  exit 1
fi

SLUG="$(printf '%s' "${NAME}" | /usr/bin/tr -c 'A-Za-z0-9._-' '_')"
STATE="${STATE_DIR}/${SLUG}.json"

PID="$(STATE="${STATE}" /usr/bin/python3 -c '
import json, os
try:
    with open(os.environ["STATE"], encoding="utf-8") as handle:
        print((json.load(handle) or {}).get("pid") or "")
except (OSError, ValueError):
    print("")
')"

if [ -z "${PID}" ] || ! /bin/ps -p "${PID}" >/dev/null 2>&1; then
  # 既に居ない。控えだけ消して、止まっていると言う。
  /bin/rm -f "${STATE}"
  echo "「${NAME}」は動いていません" | tee -a "${LOG}"
  "${SCRIPT_DIR}/mulmo-project-status" >/dev/null 2>&1 || true
  exit 0
fi

echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] stop requested: ${NAME} (pid ${PID})" >>"${LOG}"
# まず穏やかに頼む。落ちなければ諦めて強く言う。
/bin/kill "${PID}" 2>/dev/null || true
WAITED=0
while [ "${WAITED}" -lt 8 ]; do
  /bin/ps -p "${PID}" >/dev/null 2>&1 || break
  sleep 1
  WAITED=$((WAITED + 1))
done
/bin/ps -p "${PID}" >/dev/null 2>&1 && /bin/kill -9 "${PID}" 2>/dev/null || true

/bin/rm -f "${STATE}"
echo "「${NAME}」を止めました" | tee -a "${LOG}"
"${SCRIPT_DIR}/mulmo-project-status" >/dev/null 2>&1 || true

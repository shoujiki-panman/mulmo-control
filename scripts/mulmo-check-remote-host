#!/bin/zsh
set -u

# スマホ連携（RemoteHost）が繋がっているかを見る。
# 切れても MulmoTerminal 自体は動き続けるので、画面のどこにも出ない。
# 上流でも「切れたことに気づけない」不具合が繰り返し直されている
# （receptron/mulmoterminal#823, #1045）。

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
OUT="${LOG_DIR}/remote-host.json"
OUT_MC="${LOG_DIR}/remote-host-mulmoclaude.json"
# ポートは共有定義から取る（Issue #7）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/mulmoterminal-agent-env"
BASE="http://${MULMO_AGENT_HOST}:${MULMO_AGENT_PORT}"

mkdir -p "${LOG_DIR}"

# 預かった鍵があるかどうか（Issue #154）。中身は読まない。あるかどうかだけ。
# `-w` を付けないので、この呼び出しは blob そのものを標準出力に出さない。
MT_STASHED=false
if /usr/bin/security find-generic-password \
  -s "${MULMO_MT_SESSION_SERVICE}" -a "${MULMO_MT_SESSION_ACCOUNT}" >/dev/null 2>&1; then
  MT_STASHED=true
fi

write() {
  cat > "${OUT}" <<JSON
{
  "checkedAt": "$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)",
  "state": "$1",
  "hasSession": $2,
  "detail": "$3",
  "hasStash": ${MT_STASHED}
}
JSON
}

RAW="$(/usr/bin/curl -s -m 6 "${BASE}/api/remote-host/status" 2>/dev/null || true)"
if [ -z "${RAW}" ]; then
  # MulmoTerminal が動いていない。connected を騙るより「不明」が正しい。
  write "unknown" "false" "MulmoTerminal が動いていません"
  exit 0
fi

# 繋がっているうちに鍵を預かる（Issue #154。MulmoClaude 側の #145 と同じ形）。
#
# 接続が切れると、この blob はホスト側から消える。ブラウザの localStorage には
# 残っているが、MulmoTerminal の画面を開いていない間は繋ぎ直す主体がいない。
# ここで控えておけば、切れていても Mulmo Control 側から繋げる。
#
# **この値を echo / printf / tee に渡さないこと。** run() はスクリプトの
# stdout/stderr を丸ごと ~/Library/Logs 配下のファイルへ落とす。中身は
# Firebase の refreshToken を含む。
MT_SESSION="$(RAW="${RAW}" /usr/bin/python3 -c '
import json, os
try:
    print(json.loads(os.environ["RAW"]).get("session") or "")
except ValueError:
    print("")
')"
if [ -n "${MT_SESSION}" ]; then
  /usr/bin/security add-generic-password -U \
    -s "${MULMO_MT_SESSION_SERVICE}" -a "${MULMO_MT_SESSION_ACCOUNT}" \
    -w "${MT_SESSION}" >/dev/null 2>&1 || true
  MT_STASHED=true
fi
unset MT_SESSION

RAW="${RAW}" OUT="${OUT}" STASHED="${MT_STASHED}" /usr/bin/python3 <<'PY'
import json, os, datetime

raw = os.environ["RAW"]
out = os.environ["OUT"]
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

try:
    data = json.loads(raw)
except ValueError:
    state, has_session, detail = "unknown", False, "状態を読めませんでした"
else:
    connected = bool(data.get("status", {}).get("connected"))
    has_session = bool(data.get("session"))
    health = (data.get("health") or {}).get("state") or ""
    last_error = (data.get("health") or {}).get("lastError")
    if connected:
        state, detail = "online", "スマホから使えます"
    elif has_session:
        # 一度繋がったが落ちた。session があるので再接続できる。
        state = "offline"
        detail = f"切れています（{last_error}）" if last_error else "切れています"
    else:
        # 一度も繋いでいない。再接続する対象がないので、案内に回す。
        state = "never"
        detail = "まだ繋いでいません"

with open(out, "w", encoding="utf-8") as f:
    json.dump({"checkedAt": now, "state": state, "hasSession": has_session, "detail": detail,
               "hasStash": os.environ.get("STASHED") == "true"},
              f, ensure_ascii=False, indent=2)
PY

# MulmoClaude 側のスマホ連携も見る（Issue #78）。
#
# スマホ連携は2つある。MulmoTerminal(34567) はターミナルを、MulmoClaude(3001)
# はチャットをスマホから操作するためのもので、同じ Google アカウントを使うが
# 接続は別々。以前はここが MulmoTerminal しか見ていないのに、画面には主語なしで
# 「スマホ連携」と出していたので、MulmoClaude 側が切れていても「使えます」と
# 表示していた。
# 設定は shell として実行せず、許可したキーの値だけを読む（Issue #67）。
# `. "${CONFIG}"` だと、設定ファイルに紛れた `touch ...` や `$(...)` が
# 読んだ側の権限でそのまま走る。
MC_DIR="$("${SCRIPT_DIR}/mulmo-config-get" MULMO_CONTROL_MULMOCLAUDE_DIR)"
MC_DIR="${MC_DIR:-${HOME}/mulmoclaude}"

# 預かった鍵があるかどうか（Issue #145）。中身は読まない。あるかどうかだけ。
#
# これが true なら、MulmoClaude が止まっていても Mulmo Control 側から繋げる。
# 画面のボタンはこれを見て「繋ぐ」と「設定を開く」を出し分ける。
# `-w` を付けないので、この呼び出しは blob そのものを標準出力に出さない。
STASHED=false
if /usr/bin/security find-generic-password \
  -s "${MULMO_MC_SESSION_SERVICE}" -a "${MULMO_MC_SESSION_ACCOUNT}" >/dev/null 2>&1; then
  STASHED=true
fi

write_mc() {
  STASHED="${STASHED}" /usr/bin/python3 -c '
import json, os, sys, datetime
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
json.dump({"checkedAt": now, "state": sys.argv[2], "hasSession": sys.argv[3] == "true",
           "detail": sys.argv[4], "hasStash": os.environ.get("STASHED") == "true"},
          open(sys.argv[1], "w", encoding="utf-8"), ensure_ascii=False, indent=2)
' "${OUT_MC}" "$1" "$2" "$3"
}

# API は Bearer 認証。トークンはワークスペース直下に置かれている。
MC_TOKEN=""
[ -f "${MC_DIR}/.session-token" ] && MC_TOKEN="$(/bin/cat "${MC_DIR}/.session-token" 2>/dev/null || true)"

if [ -z "${MC_TOKEN}" ]; then
  write_mc "unknown" "false" "MulmoClaude が動いていません"
  exit 0
fi

MC_RAW="$(/usr/bin/curl -s -m 6 -H "Authorization: Bearer ${MC_TOKEN}" \
  "http://127.0.0.1:3001/api/remote-host/status" 2>/dev/null || true)"
if [ -z "${MC_RAW}" ]; then
  write_mc "unknown" "false" "MulmoClaude が動いていません"
  exit 0
fi

# 繋がっているうちに鍵を預かる（Issue #145）。
#
# MulmoClaude を止めると、この blob はホスト側から消える（メモリにしか無い）。
# ブラウザの localStorage にも同じものが park されているが、MulmoClaude の画面を
# 開いていない間は繋ぎ直す主体がいない。ここで控えておけば、止まっていても
# Mulmo Control 側から繋げる。
#
# **この値を echo / printf / tee に渡さないこと。** run() はスクリプトの
# stdout/stderr を丸ごと ~/Library/Logs 配下のファイルへ落とす。中身は
# Firebase の refreshToken を含む。
#
# 鍵の更新に失敗しても、状態を書く仕事は続ける（`|| true`）。預かりは
# 次の巡回でやり直せるが、状態が書けないと画面が「未確認」に落ちる。
MC_SESSION="$(MC_RAW="${MC_RAW}" /usr/bin/python3 -c '
import json, os
try:
    print(json.loads(os.environ["MC_RAW"]).get("session") or "")
except ValueError:
    print("")
')"
if [ -n "${MC_SESSION}" ]; then
  /usr/bin/security add-generic-password -U \
    -s "${MULMO_MC_SESSION_SERVICE}" -a "${MULMO_MC_SESSION_ACCOUNT}" \
    -w "${MC_SESSION}" >/dev/null 2>&1 || true
  STASHED=true
fi
unset MC_SESSION

RAW="${MC_RAW}" OUT="${OUT_MC}" STASHED="${STASHED}" /usr/bin/python3 <<'PY2'
import json, os, datetime
raw = os.environ["RAW"]; out = os.environ["OUT"]
stashed = os.environ.get("STASHED") == "true"
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
try:
    data = json.loads(raw)
except ValueError:
    state, has_session, detail = "unknown", False, "状態を読めませんでした"
else:
    connected = bool(data.get("status", {}).get("connected"))
    has_session = bool(data.get("session"))
    last_error = (data.get("health") or {}).get("lastError")
    if connected:
        state, detail = "online", "スマホから使えます"
    elif has_session:
        state = "offline"
        detail = f"切れています（{last_error}）" if last_error else "切れています"
    else:
        state, detail = "never", "まだ繋いでいません"
with open(out, "w", encoding="utf-8") as f:
    json.dump({"checkedAt": now, "state": state, "hasSession": has_session, "detail": detail,
               "hasStash": stashed}, f, ensure_ascii=False, indent=2)
PY2

#!/bin/zsh
set -u

# 登録したプロジェクトのリモートセッションを立てる（Issue #152）。
#
#   使い方: mulmo-project-start <プロジェクト名>
#
# 実測（2026-08-28）で分かったこと:
#
#   - `claude --remote-control` は **TTY が要る**。無いと --print に落ちて失敗する。
#     script(1) で PTY を与え、nohup で切り離せば端末なしで生き残る
#   - 立ち上がると「Continue here, on your phone, or at https://claude.ai/code/…」
#     が出る。スマホはそこから入る
#   - 初回はディレクトリの信頼確認が出て止まる。**そこは人が踏む**
#
# **セッションの画面出力は保存しない。** 会話がそのまま平文でログに残るため。
# 立ったかどうかは、控えた pid の生死と `claude agents --json` で見る。

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_SUPPORT="${HOME}/Library/Application Support/Mulmo Control"
CONFIG="${APP_SUPPORT}/projects.json"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
LOG="${LOG_DIR}/projects.log"
STATE_DIR="${LOG_DIR}/project-sessions"

NAME="${1:-}"
mkdir -p "${LOG_DIR}" "${STATE_DIR}"

if [ -z "${NAME}" ]; then
  echo "プロジェクト名を渡してください" | tee -a "${LOG}"
  exit 1
fi

echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] start requested: ${NAME}" >>"${LOG}"

# 登録は shell として実行しない。JSON として読む（Issue #67）。
PROJECT="$(NAME="${NAME}" CONFIG="${CONFIG}" /usr/bin/python3 -c '
import json, os, sys
try:
    with open(os.environ["CONFIG"], encoding="utf-8") as handle:
        entries = (json.load(handle) or {}).get("projects") or []
except (OSError, ValueError):
    sys.exit(0)
for entry in entries:
    if isinstance(entry, dict) and entry.get("name") == os.environ["NAME"]:
        path = entry.get("path")
        if isinstance(path, str) and path:
            print(os.path.realpath(os.path.expanduser(path)))
        break
')"

if [ -z "${PROJECT}" ]; then
  echo "「${NAME}」は登録されていません" | tee -a "${LOG}"
  exit 1
fi
if [ ! -d "${PROJECT}" ]; then
  echo "フォルダが見つかりません: ${PROJECT}" | tee -a "${LOG}"
  exit 1
fi

SLUG="$(printf '%s' "${NAME}" | /usr/bin/tr -c 'A-Za-z0-9._-' '_')"
STATE="${STATE_DIR}/${SLUG}.json"

# 繋がっているのに立て直さない。#147 で踏んだ「繋がっているのに繋ぎ直して
# 期限切れだと嘘をつく」と同じ形になる。
RUNNING_PID="$(STATE="${STATE}" /usr/bin/python3 -c '
import json, os
try:
    with open(os.environ["STATE"], encoding="utf-8") as handle:
        print((json.load(handle) or {}).get("pid") or "")
except (OSError, ValueError):
    print("")
')"
if [ -n "${RUNNING_PID}" ] && /bin/ps -p "${RUNNING_PID}" >/dev/null 2>&1; then
  echo "「${NAME}」はすでに繋がっています" | tee -a "${LOG}"
  "${SCRIPT_DIR}/mulmo-project-status" >/dev/null 2>&1 || true
  exit 0
fi

CLAUDE="$(command -v claude || true)"
if [ -z "${CLAUDE}" ]; then
  echo "claude が見つかりません" | tee -a "${LOG}"
  exit 1
fi

# 信頼確認は人が踏むもの。こちらで ~/.claude.json を書いて飛ばさない
# （人間の同意を機械が偽造する形になる）。初回だけターミナルを開く。
TRUSTED="$(PROJECT="${PROJECT}" /usr/bin/python3 -c '
import json, os
try:
    with open(os.path.expanduser("~/.claude.json"), encoding="utf-8") as handle:
        projects = (json.load(handle) or {}).get("projects") or {}
except (OSError, ValueError):
    projects = {}
target = os.environ["PROJECT"]
for path, item in projects.items():
    if not isinstance(item, dict):
        continue
    if os.path.realpath(os.path.expanduser(path)) == target and item.get("hasTrustDialogAccepted"):
        print("yes")
        break
')"

if [ "${TRUSTED}" != "yes" ]; then
  echo "初めてのフォルダです。確認のためターミナルを開きます" | tee -a "${LOG}"
  /usr/bin/osascript -e 'on run argv
  tell application "Terminal"
    activate
    do script "cd " & quoted form of (item 1 of argv) & " && " & quoted form of (item 2 of argv) & " --remote-control " & quoted form of (item 3 of argv)
  end tell
end run' "${PROJECT}" "${CLAUDE}" "${NAME}" >/dev/null 2>&1 || true
  exit 2
fi

# PTY を与えて切り離す。画面出力は捨てる（会話が平文で残るため）。
cd "${PROJECT}" || exit 1
/usr/bin/nohup /usr/bin/script -q /dev/null "${CLAUDE}" --remote-control "${NAME}" \
  >/dev/null 2>&1 </dev/null &
PID=$!

# 立ち上がるのを待つ。**`claude agents --json --cwd` では確かめられない。**
# 同じフォルダに前から居るセッションにも当たるので、自分が立てたものが
# 出たのか区別できない（実測で、既存4件に当たって即通過した）。
# ここで見られるのは「落ちずに残っているか」だけ。それを正直に見る。
SETTLE=6
WAITED=0
while [ "${WAITED}" -lt "${SETTLE}" ]; do
  /bin/ps -p "${PID}" >/dev/null 2>&1 || break
  sleep 2
  WAITED=$((WAITED + 2))
done

if ! /bin/ps -p "${PID}" >/dev/null 2>&1; then
  echo "「${NAME}」を繋げませんでした" | tee -a "${LOG}"
  exit 1
fi

PID="${PID}" NAME="${NAME}" PROJECT="${PROJECT}" STATE="${STATE}" /usr/bin/python3 -c '
import json, os, datetime
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
with open(os.environ["STATE"], "w", encoding="utf-8") as handle:
    json.dump({"name": os.environ["NAME"], "path": os.environ["PROJECT"],
               "pid": int(os.environ["PID"]), "startedAt": now},
              handle, ensure_ascii=False, indent=2)
'
echo "「${NAME}」を繋ぎました" | tee -a "${LOG}"
"${SCRIPT_DIR}/mulmo-project-status" >/dev/null 2>&1 || true

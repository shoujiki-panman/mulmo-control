#!/bin/zsh
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/mulmoterminal-agent-env"

label="${MULMO_AGENT_LABEL}"
domain="${MULMO_AGENT_DOMAIN}"

if /bin/launchctl print "${domain}/${label}" >/dev/null 2>&1; then
  echo "MulmoTerminal: loaded"
  /bin/launchctl print "${domain}/${label}" | /usr/bin/awk '
    /state =/ { print "state: " $3 }
    /pid =/ { print "pid: " $3 }
    /last exit code =/ { print "last exit code: " $5 }
  '
else
  echo "MulmoTerminal: not loaded"
fi

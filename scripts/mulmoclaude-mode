#!/bin/zsh
set -u

# MulmoClaude をどちらのモードで起こすか（Issue #168）。
#
#   app  通常モード（既定）。ビルド済みの画面を production で配る。監視なし
#   dev  開発モード。`yarn dev`。保存のたびに画面が作り直される
#
# 既定は app（Issue #174）。
#
# #168 では dev を既定にした。「いま使っている人の挙動を変えない」ためだったが、
# **開発者モードを選んだ人は一人もいなかった。** 他に道が無かっただけで、しかも
# 気づく手がかりが1つも無い（リロードにはログ行すら出ない）。守っていたのは
# 選択ではなく事故だった。自分で開発モードを選んだ人は、このファイルを持って
# いるので影響を受けない。
#
# 置き場所が app-info.env でないのは、install.sh があのファイルを更新のたびに
# 丸ごと書き直すため（install.sh:132）。そこに置くと、更新のたびにモードが
# 既定へ戻る。Sources/main.swift の初回通知が UserDefaults を選んだのと同じ
# 理由で、install.sh が触らない場所に置く。
#
# 値は「その2語かどうか」だけを見る。読んだ文字列をそのまま使う経路が
# 起動コマンドの組み立てにあるので、知らない文字は既定に倒す（Issue #67）。

FILE="${MULMO_MODE_FILE:-${HOME}/Library/Application Support/Mulmo Control/mulmoclaude-mode}"

MODE=""
if [ -f "${FILE}" ]; then
  MODE="$(/usr/bin/head -1 "${FILE}" 2>/dev/null | /usr/bin/tr -d '[:space:]')"
fi

case "${MODE}" in
  app|dev) ;;
  *) MODE="app" ;;
esac

printf '%s\n' "${MODE}"

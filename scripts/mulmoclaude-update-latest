#!/bin/zsh
set -u

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# 兄弟スクリプトは自分と同じディレクトリから呼ぶ（Issue #11）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# 設定は shell として実行せず、許可したキーの値だけを読む（Issue #67）。
# `. "${CONFIG}"` だと、設定ファイルに紛れた `touch ...` や `$(...)` が
# 読んだ側の権限でそのまま走る。
APP_DIR="$("${SCRIPT_DIR}/mulmo-config-get" MULMO_CONTROL_MULMOCLAUDE_DIR)"
APP_DIR="${APP_DIR:-${HOME}/mulmoclaude}"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
LOG="${LOG_DIR}/mulmoclaude-update.log"

mkdir -p "${LOG_DIR}"

if [ ! -d "${APP_DIR}/.git" ]; then
  echo "MulmoClaude repo was not found: ${APP_DIR}" | tee -a "${LOG}"
  exit 1
fi

echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] update requested" | tee -a "${LOG}"
cd "${APP_DIR}"

START="${SCRIPT_DIR}/mulmoclaude-start"

# 更新できなかった理由を、画面に出せる形で残す。
#
# 以前は「詳しくはログを見てください」で終わっていた。ターミナルを開かせない
# ためのアプリなのに、git の出力を読めと言っているのと同じだった（Issue #46）。
# アプリはこのファイルを読んで、版が変わらなかった行に理由を添える。
REASONS="${LOG_DIR}/mulmo-update-reasons.txt"
say_reason() {
  printf '%s\t%s\n' "mulmoclaude" "$1" >> "${REASONS}"
}

# 更新のために止めているので、失敗して抜ける時も必ず起動し直す。
fail() {
  "${START}" >>"${LOG}" 2>&1 || true
  echo "$1" | tee -a "${LOG}"
  say_reason "$1"
  exit 1
}

"${SCRIPT_DIR}/mulmoclaude-stop" >>"${LOG}" 2>&1 || true

# MulmoClaude は普通に使っているだけで CLAUDE.md や .claude/settings.json が
# 書き換わる。放っておくと git pull が必ず止まるので、退避はこちらで面倒を見る。
# ターミナルを開かせないのがこのアプリの役目なので、ここで git stash を求めない。
STASHED=0
if [ -n "$(/usr/bin/git status --porcelain)" ]; then
  STAMP="$(/bin/date '+%Y-%m-%d %H:%M:%S')"
  echo "MulmoClaude: ローカルに変更があるので、いったん退避します" | tee -a "${LOG}"
  if /usr/bin/git stash push -u -m "mulmo-control auto-stash ${STAMP}" >>"${LOG}" 2>&1; then
    STASHED=1
  else
    fail "MulmoClaude: ローカルの変更を退避できなかったので、更新を中止しました"
  fi
fi

# 退避したものは、どの道でも必ず戻す。
#
# git stash pop はぶつかったとき、失敗を返しながら作業ツリーにコンフリクト
# マーカーを書き込んで止まる。stash を消さないのは正しい挙動だが、「戻せな
# かった」と「中途半端に戻して壊した」は別物で、後者を「戻せませんでした」と
# だけ言って先へ進むと、壊れた package.json のまま yarn install と起動まで
# 走り、利用者には Vite のエラー画面と「更新しました」だけが届く（Issue #66）。
#
# 戻り値: 0=戻せた / 1=何も戻らなかった / 2=途中でぶつかって壊れている
restore_stash() {
  [ "${STASHED}" = "1" ] || return 0
  STASHED=0
  if /usr/bin/git stash pop >>"${LOG}" 2>&1; then
    echo "MulmoClaude: 退避した変更を戻しました" | tee -a "${LOG}"
    return 0
  fi
  UNMERGED="$(/usr/bin/git diff --name-only --diff-filter=U 2>/dev/null | tr '\n' ' ')"
  if [ -n "${UNMERGED}" ]; then
    echo "MulmoClaude: 退避した変更を戻す途中でぶつかりました。次のファイルが未解決です: ${UNMERGED}" | tee -a "${LOG}"
    return 2
  fi
  echo "MulmoClaude: 退避した変更を戻せませんでした（git stash list に残しています）" | tee -a "${LOG}"
  return 1
}

# 別のブランチを見ていると、git pull は「そのブランチとして」成功する。
# 失敗しないので誰も気づかないまま、本体の更新だけが永遠に届かない。実際に
# それで「更新できませんでした」が出た（Issue #46）。
#
# ターミナルを開かせないのがこのアプリの役目なので、ここで「main に戻して
# ください」とは言わない。退避と同じく、こちらで戻す。
DEFAULT_BRANCH="$(/usr/bin/git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | /usr/bin/sed 's|^origin/||')"
[ -n "${DEFAULT_BRANCH}" ] || DEFAULT_BRANCH="main"
CURRENT_BRANCH="$(/usr/bin/git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

if [ -n "${CURRENT_BRANCH}" ] && [ "${CURRENT_BRANCH}" != "${DEFAULT_BRANCH}" ]; then
  echo "MulmoClaude: ${CURRENT_BRANCH} を見ていたので ${DEFAULT_BRANCH} に戻します" | tee -a "${LOG}"
  if /usr/bin/git checkout "${DEFAULT_BRANCH}" >>"${LOG}" 2>&1; then
    say_reason "${CURRENT_BRANCH} を見ていたので ${DEFAULT_BRANCH} に戻して更新しました"
  else
    restore_stash
    fail "MulmoClaude: ${CURRENT_BRANCH} を見ており、${DEFAULT_BRANCH} に戻せなかったので更新できませんでした"
  fi
fi

BEFORE_HEAD="$(/usr/bin/git rev-parse HEAD 2>/dev/null || echo "")"

# 失敗を握りつぶさない。ここで黙って先へ進むと、1行も更新されていないのに
# アプリが「一括更新しました」と報告してしまう。
if ! /usr/bin/git pull --ff-only >>"${LOG}" 2>&1; then
  restore_stash
  fail "MulmoClaude: git pull に失敗したので、更新できませんでした"
fi

restore_stash
RESTORE_STATUS=$?

# 壊れている状態で yarn install と起動まで進まない。ここで止めないと、
# 利用者には「更新しました」とだけ届き、開くとエラー画面になる（Issue #66）。
if [ "${RESTORE_STATUS}" = "2" ]; then
  fail "MulmoClaude: 退避した変更を戻す途中でぶつかり、ファイルが壊れたままです。解消するまで MulmoClaude は正しく開きません（対象は更新ログに出しています）"
fi

# 何も落ちてこなかったなら、そう言う。黙っていると「更新できませんでした」
# だけが残り、壊れているのか元から最新なのか区別が付かない（Issue #46）。
if [ "$(/usr/bin/git rev-parse HEAD 2>/dev/null || echo "")" = "${BEFORE_HEAD}" ]; then
  say_reason "すでに最新でした"
fi

if command -v yarn >/dev/null 2>&1; then
  if ! yarn install >>"${LOG}" 2>&1; then
    fail "MulmoClaude: yarn install に失敗したので、更新できませんでした"
  fi
fi

"${START}" >>"${LOG}" 2>&1 || true
echo "MulmoClaude: updated" | tee -a "${LOG}"

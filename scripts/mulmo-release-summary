#!/bin/zsh
set -u

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
OUT="${LOG_DIR}/mulmo-control-last-update-summary.txt"
ITEMS_B64="${MULMO_RELEASE_ITEMS_B64:-}"

mkdir -p "${LOG_DIR}"
: > "${OUT}"

NODE="$(command -v node || true)"
if [ -z "${NODE}" ] || [ -z "${ITEMS_B64}" ]; then
  exit 0
fi

ITEMS="$(printf '%s' "${ITEMS_B64}" | /usr/bin/base64 --decode 2>/dev/null || true)"
if [ -z "${ITEMS}" ]; then
  exit 0
fi

ITEMS="${ITEMS}" OUT="${OUT}" "${NODE}" <<'NODE'
const fs = require("fs");
const https = require("https");

const out = process.env.OUT;
const items = (process.env.ITEMS || "")
  .split(/\n/)
  .map((line) => line.split(/\t/))
  .filter((parts) => parts.length >= 3)
  .map(([id, displayName, latest]) => ({ id, displayName, latest }));

function fetchText(url) {
  return new Promise((resolve, reject) => {
    https.get(url, { headers: { "User-Agent": "Mulmo Control" } }, (res) => {
      if (res.statusCode < 200 || res.statusCode >= 300) {
        reject(new Error(`HTTP ${res.statusCode}`));
        res.resume();
        return;
      }
      let body = "";
      res.setEncoding("utf8");
      res.on("data", (chunk) => { body += chunk; });
      res.on("end", () => resolve(body));
    }).on("error", reject);
  });
}

function sectionFor(markdown, heading) {
  const start = markdown.indexOf(heading);
  if (start < 0) return "";
  const rest = markdown.slice(start);
  const next = rest.slice(heading.length).search(/\n## /);
  if (next < 0) return rest;
  return rest.slice(0, heading.length + next);
}

// 上流の語彙を当てにいくと、書き方が変わった時点で黙って動かなくなる。
// 実際、この関数は 4.1.1 以降ずっと空振りしていた。構造だけを頼りに取り出す。

/// 装飾を落として1行にする。太字・リンク・コード・末尾の issue 番号を外す。
function plain(text) {
  return text
    .replace(/\*\*(.+?)\*\*/g, "$1")
    .replace(/\[(.+?)\]\([^)]*\)/g, "$1")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/\s*\([^()]*#\d+[^()]*\)\s*$/, "")
    .replace(/\s+/g, " ")
    .trim();
}

/// 節の冒頭、最初の ### が始まるまでの地の文。その最初の一文がその版の要点。
///
/// 以前は「最初の太字」を要点とみなしていたが、上流が書き方を変えると壊れる。
/// 4.9.0 では本文の途中にある `**agent**` を拾って、画面に「・agent」とだけ
/// 出ていた。4.8.5 では条件つきの注意書きが先頭に来て、要約になっていなかった。
/// 太字は強調であって要約ではないので、置き場所で決める。
function leadSentence(section) {
  const lead = [];
  for (const line of section.split(/\n/).slice(1)) {
    if (line.startsWith("###")) break;          // 個別の項目に入ったら終わり
    if (line.startsWith(">") || !line.trim()) continue;  // Setup guide の引用と空行
    lead.push(line.trim());
  }
  const body = plain(lead.join(" "));
  const first = body.match(/(.+?[.。])(\s|$)/);
  return (first ? first[1] : body).trim();
}

/// 各項目の見出し。冒頭の地の文が無い版（4.8.3 など）はここから始める。
function itemHeadings(section) {
  return [...section.matchAll(/^###\s+(.+?)\s*$/gm)].map((m) => plain(m[1])).filter(Boolean);
}

/// 日本語のセットアップガイドへのリンク。各版の節が自分で持っている。
function japaneseGuideURL(section) {
  const ja = section.match(/\[日本語\]\((https:\/\/[^)]+)\)/);
  if (ja) return ja[1];
  const en = section.match(/(https:\/\/receptron\.github\.io\/mulmoterminal\/guide\/)en\/([^)\s]+)/);
  return en ? `${en[1]}ja/${en[2]}` : "";
}

function summarizeMulmoTerminal(section) {
  const bullets = [];
  const lead = leadSentence(section);
  if (lead) bullets.push(lead);
  for (const heading of itemHeadings(section)) {
    if (bullets.length >= 3) break;             // 画面に収まる分だけ
    if (!bullets.includes(heading)) bullets.push(heading);
  }
  const lines = bullets.map((b) => `・${b}`);
  const guide = japaneseGuideURL(section);
  if (guide) lines.push(`ガイド: ${guide}`);
  return lines;
}

/// MulmoClaude は GitHub のリリースノートに要点を書いている。
///
/// 拾うのは形式が保証している2つだけ。リリース名の em ダッシュ以降と、
/// Highlights の下に並ぶ ### 見出しから括弧の issue 番号を落としたもの。
/// 本文の段落は1項目で数千字あることがあるので持ち込まない。
function summarizeMulmoClaude(release) {
  const lines = [];

  // "v1.13.1 — a Google Calendar collection finally receives the calendar"
  const name = String(release.name || "");
  const dash = name.indexOf("\u2014");
  const lead = dash >= 0 ? name.slice(dash + 1).trim() : "";
  if (lead) lines.push(`・${lead}`);

  const body = String(release.body || "");
  const start = body.search(/^##\s+Highlights\s*$/m);
  if (start >= 0) {
    const rest = body.slice(start);
    const end = rest.slice(1).search(/^##\s+(?!#)/m);
    const section = end < 0 ? rest : rest.slice(0, end + 1);
    for (const line of section.split(/\n/)) {
      const heading = line.match(/^###\s+(.+?)\s*$/);
      if (!heading) continue;
      // 番号は「(#2850)」だけでなく「(#2844, #2848, #2849)」の形もある。
      // 実物で1行だけ取りこぼして気づいた。
      const text = heading[1].replace(/\s*\(#\d+(?:\s*,\s*#\d+)*\)\s*$/, "").trim();
      if (text && !lines.includes(`・${text}`)) lines.push(`・${text}`);
      if (lines.length >= 4) break;              // 画面に収まる分だけ
    }
  }

  if (release.html_url) lines.push(`詳しく: ${release.html_url}`);
  return lines;
}

async function main() {
  const lines = [];
  for (const item of items) {
    if (item.id === "mulmoclaude") {
      try {
        const json = await fetchText(
          `https://api.github.com/repos/receptron/mulmoclaude/releases/tags/v${item.latest}`
        );
        const bullets = summarizeMulmoClaude(JSON.parse(json));
        if (bullets.length > 0) {
          lines.push(`更新の内容（${item.displayName}）`);
          for (const bullet of bullets) lines.push(bullet);
        } else {
          lines.push(`更新の内容（${item.displayName}）: リリースノートを確認しましたが、要約できる見出しがありませんでした。`);
        }
      } catch {
        lines.push(`更新の内容（${item.displayName}）: リリースノートを取得できませんでした。`);
      }
    }
    if (item.id === "mulmoterminal") {
      try {
        const changelog = await fetchText("https://raw.githubusercontent.com/receptron/mulmoterminal/main/docs/ChangeLog.md");
        const section = sectionFor(changelog, `## mulmoterminal@${item.latest}`);
        const bullets = summarizeMulmoTerminal(section);
        if (bullets.length > 0) {
          // summarize 側が中黒を付けて返すので、ここでは付けない。
          // 両方で付けていて「・・」と出ていた。
          lines.push(`更新の内容（${item.displayName}）`);
          for (const bullet of bullets) lines.push(bullet);
        } else {
          lines.push(`更新の内容（${item.displayName}）: 公式Changelogを確認しましたが、要約できる見出しがありませんでした。`);
        }
      } catch {
        lines.push(`更新の内容（${item.displayName}）: 公式Changelogを取得できませんでした。`);
      }
    }
  }
  fs.writeFileSync(out, lines.join("\n"));
}

main().catch(() => {
  fs.writeFileSync(out, "更新の内容: 公式Changelogを取得できませんでした。");
});
NODE

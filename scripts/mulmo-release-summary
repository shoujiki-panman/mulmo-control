#!/bin/zsh
set -u

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
LOG_DIR="${HOME}/Documents/Codex/SwiftBarLogs"
OUT="${LOG_DIR}/mulmo-control-last-update-summary.txt"
ITEMS_B64="${MULMO_RELEASE_ITEMS_B64:-}"

mkdir -p "${LOG_DIR}"
: > "${OUT}"

NODE="$(command -v node || true)"
if [ -z "${NODE}" ] || [ -z "${ITEMS_B64}" ]; then
  exit 0
fi

ITEMS="$(printf '%s' "${ITEMS_B64}" | /usr/bin/base64 --decode 2>/dev/null || true)"
if [ -z "${ITEMS}" ]; then
  exit 0
fi

ITEMS="${ITEMS}" OUT="${OUT}" "${NODE}" <<'NODE'
const fs = require("fs");
const https = require("https");

const out = process.env.OUT;
const items = (process.env.ITEMS || "")
  .split(/\n/)
  .map((line) => line.split(/\t/))
  .filter((parts) => parts.length >= 3)
  .map(([id, displayName, latest]) => ({ id, displayName, latest }));

function fetchText(url) {
  return new Promise((resolve, reject) => {
    https.get(url, { headers: { "User-Agent": "Mulmo Control" } }, (res) => {
      if (res.statusCode < 200 || res.statusCode >= 300) {
        reject(new Error(`HTTP ${res.statusCode}`));
        res.resume();
        return;
      }
      let body = "";
      res.setEncoding("utf8");
      res.on("data", (chunk) => { body += chunk; });
      res.on("end", () => resolve(body));
    }).on("error", reject);
  });
}

function sectionFor(markdown, heading) {
  const start = markdown.indexOf(heading);
  if (start < 0) return "";
  const rest = markdown.slice(start);
  const next = rest.slice(heading.length).search(/\n## /);
  if (next < 0) return rest;
  return rest.slice(0, heading.length + next);
}

// 上流の語彙を当てにいくと、書き方が変わった時点で黙って動かなくなる。
// 実際、この関数は 4.1.1 以降ずっと空振りしていた。構造だけを頼りに取り出す。

/// その版の要点は、節の先頭にある太字の一文に書かれている。
function leadSentence(section) {
  const body = section
    .split(/\n/)
    .slice(1)                                  // 見出しの行を落とす
    .filter((line) => !line.startsWith(">"))   // Setup guide の引用を飛ばす
    .join("\n");
  const bold = body.match(/\*\*([\s\S]+?)\*\*/);
  if (!bold) return "";
  return bold[1].replace(/\s+/g, " ").trim();
}

/// 日本語のセットアップガイドへのリンク。各版の節が自分で持っている。
function japaneseGuideURL(section) {
  const ja = section.match(/\[日本語\]\((https:\/\/[^)]+)\)/);
  if (ja) return ja[1];
  const en = section.match(/(https:\/\/receptron\.github\.io\/mulmoterminal\/guide\/)en\/([^)\s]+)/);
  return en ? `${en[1]}ja/${en[2]}` : "";
}

function summarizeMulmoTerminal(section) {
  const lines = [];
  const lead = leadSentence(section);
  if (lead) lines.push(`・${lead}`);
  const guide = japaneseGuideURL(section);
  if (guide) lines.push(`ガイド: ${guide}`);
  return lines;
}

async function main() {
  const lines = [];
  for (const item of items) {
    if (item.id === "mulmoterminal") {
      try {
        const changelog = await fetchText("https://raw.githubusercontent.com/receptron/mulmoterminal/main/docs/ChangeLog.md");
        const section = sectionFor(changelog, `## mulmoterminal@${item.latest}`);
        const bullets = summarizeMulmoTerminal(section);
        if (bullets.length > 0) {
          lines.push("新機能");
          for (const bullet of bullets) lines.push(`・${bullet}`);
        } else {
          lines.push("新機能: 公式Changelogを確認しましたが、要約できる見出しがありませんでした。");
        }
      } catch {
        lines.push("新機能: 公式Changelogを取得できませんでした。");
      }
    }
  }
  fs.writeFileSync(out, lines.join("\n"));
}

main().catch(() => {
  fs.writeFileSync(out, "新機能: 公式Changelogを取得できませんでした。");
});
NODE

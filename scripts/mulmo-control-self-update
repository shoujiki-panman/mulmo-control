#!/bin/zsh
set -u

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# このスクリプトはアプリに同梱されて /Applications/Mulmo Control.app の中から
# 走る（Issue #11）。ところが apply が呼ぶ install.sh は、その .app を丸ごと
# rm -rf してから置き直す。zsh はスクリプトを最後まで読み込まずに少しずつ読んで
# 実行するので、消えたファイルの続きを読もうとすると途中で死ぬ。
# バンドルの外に自分の写しを作り、そちらへ移ってから作業する。
if [ "${1:-check}" = "apply" ] && [ "${MULMO_SELF_UPDATE_DETACHED:-0}" != "1" ]; then
  original_script_dir="$(cd "$(dirname "$0")" && pwd)"
  detached="$(/usr/bin/mktemp -t mulmo-control-self-update)"
  /bin/cat "$0" > "${detached}"
  /bin/chmod +x "${detached}"
  MULMO_SELF_UPDATE_SCRIPT_DIR="${original_script_dir}" MULMO_SELF_UPDATE_DETACHED=1 exec "${detached}" "$@"
fi
SCRIPT_DIR="${MULMO_SELF_UPDATE_SCRIPT_DIR:-$(cd "$(dirname "$0")" && pwd)}"
. "${SCRIPT_DIR}/mulmo-control-config"
APP_SUPPORT="${HOME}/Library/Application Support/Mulmo Control"
CONFIG="${APP_SUPPORT}/app-info.env"
STATUS="${HOME}/Library/Logs/Mulmo Control/mulmo-control-self-update.json"
LOG="${HOME}/Library/Logs/Mulmo Control/mulmo-control-self-update.log"
DEFAULT_REPO="https://github.com/shoujiki-panman/mulmo-control.git"

mkdir -p "${APP_SUPPORT}" "${HOME}/Library/Logs/Mulmo Control"

APP_PLIST="/Applications/Mulmo Control.app/Contents/Info.plist"

repo_url="${DEFAULT_REPO}"
source_dir="${APP_SUPPORT}/source"
branch="main"

configured_repo_url="$(mulmo_control_config_value "MULMO_CONTROL_REPO_URL" "${CONFIG}")"
configured_source_dir="$(mulmo_control_config_value "MULMO_CONTROL_SOURCE_DIR" "${CONFIG}")"
configured_branch="$(mulmo_control_config_value "MULMO_CONTROL_BRANCH" "${CONFIG}")"

repo_url="${configured_repo_url:-${repo_url}}"
source_dir="${configured_source_dir:-${source_dir}}"
branch="${configured_branch:-${branch}}"

if [ "${MULMO_CONTROL_TEST_PRINT_CONFIG:-0}" = "1" ]; then
  REPO_URL="${repo_url}" SOURCE_DIR="${source_dir}" BRANCH="${branch}" /usr/bin/python3 - <<'PY'
import json
import os

print(json.dumps({
    "repoUrl": os.environ["REPO_URL"],
    "sourceDir": os.environ["SOURCE_DIR"],
    "branch": os.environ["BRANCH"],
}, ensure_ascii=False))
PY
  exit 0
fi

write_status() {
  local status_value="$1"
  local latest="$2"
  local detail="$3"
  cat > "${STATUS}" <<JSON
{
  "checkedAt": "$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)",
  "status": "${status_value}",
  "installedVersion": "${installed_version:-}",
  "latestVersion": "${latest}",
  "detail": "${detail}"
}
JSON
}

# 実際に入っているアプリの版。ソースの HEAD ではなくアプリ自身から読む。
# install.sh は既定でリリースの zip を落とすので、ソースが先に進んでいても
# 入るアプリは古いことがある。ソースの HEAD で報告すると、入っていない版を
# 「最新です」と言ってしまう（Issue #31）。
installed_version="$(/usr/bin/defaults read "${APP_PLIST}" CFBundleShortVersionString 2>/dev/null || true)"

# 比べる相手は「install.sh が実際に落としてくるもの」＝最新のリリースタグ。
# ls-remote なので API トークンは要らない。
latest_version="$(git ls-remote --tags --refs "${repo_url}" 2>/dev/null \
  | /usr/bin/awk -F'refs/tags/v' 'NF > 1 { print $2 }' \
  | /usr/bin/sort -V | /usr/bin/tail -1 || true)"

if [ -z "${installed_version}" ]; then
  write_status "unknown" "" "アプリの版を読めませんでした"
  exit 0
fi

if [ -z "${latest_version}" ]; then
  write_status "unknown" "" "GitHubを確認できませんでした"
  exit 0
fi

# 手元ビルドはリリースより先に進んでいることがある。その場合も「最新」でよい。
newer="$(printf '%s\n%s\n' "${installed_version}" "${latest_version}" | /usr/bin/sort -V | /usr/bin/tail -1)"
if [ "${installed_version}" = "${latest_version}" ] || [ "${newer}" = "${installed_version}" ]; then
  write_status "current" "${latest_version}" "最新版です"
  exit 0
fi

write_status "update" "${latest_version}" "アプリ更新があります"

if [ "${1:-check}" != "apply" ]; then
  exit 0
fi

(
  {
    echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] self update requested"
    if [ -d "${source_dir}/.git" ]; then
      git -C "${source_dir}" fetch origin "${branch}"
      git -C "${source_dir}" checkout "${branch}"
      git -C "${source_dir}" pull --ff-only origin "${branch}"
    else
      mkdir -p "$(dirname "${source_dir}")"
      git clone "${repo_url}" "${source_dir}"
      git -C "${source_dir}" checkout "${branch}"
    fi

    osascript -e 'tell application "Mulmo Control" to quit' >/dev/null 2>&1 || true
    sleep 1
    "${source_dir}/install.sh"
    if ! open "/Applications/Mulmo Control.app" >/dev/null 2>&1; then
      "/Applications/Mulmo Control.app/Contents/MacOS/MulmoControl" >/dev/null 2>&1 &
    fi
  } >>"${LOG}" 2>&1
) &

echo "Mulmo Control: self update started"

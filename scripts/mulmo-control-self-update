#!/bin/zsh
set -u

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# このスクリプトはアプリに同梱されて /Applications/Mulmo Control.app の中から
# 走る（Issue #11）。ところが apply が呼ぶ install.sh は、その .app を丸ごと
# rm -rf してから置き直す。zsh はスクリプトを最後まで読み込まずに少しずつ読んで
# 実行するので、消えたファイルの続きを読もうとすると途中で死ぬ。
# バンドルの外に自分の写しを作り、そちらへ移ってから作業する。
if [ "${1:-check}" = "apply" ] && [ "${MULMO_SELF_UPDATE_DETACHED:-0}" != "1" ]; then
  detached="$(/usr/bin/mktemp -t mulmo-control-self-update)"
  /bin/cat "$0" > "${detached}"
  /bin/chmod +x "${detached}"
  MULMO_SELF_UPDATE_DETACHED=1 exec "${detached}" "$@"
fi
APP_SUPPORT="${HOME}/Library/Application Support/Mulmo Control"
CONFIG="${APP_SUPPORT}/app-info.env"
STATUS="${HOME}/Documents/Codex/SwiftBarLogs/mulmo-control-self-update.json"
LOG="${HOME}/Documents/Codex/SwiftBarLogs/mulmo-control-self-update.log"
DEFAULT_REPO="https://github.com/shoujiki-panman/mulmo-control.git"

mkdir -p "${APP_SUPPORT}" "${HOME}/Documents/Codex/SwiftBarLogs"

repo_url="${DEFAULT_REPO}"
source_dir="${APP_SUPPORT}/source"
installed_commit="unknown"
branch="main"

if [ -f "${CONFIG}" ]; then
  source "${CONFIG}"
  repo_url="${MULMO_CONTROL_REPO_URL:-${repo_url}}"
  source_dir="${MULMO_CONTROL_SOURCE_DIR:-${source_dir}}"
  installed_commit="${MULMO_CONTROL_INSTALLED_COMMIT:-${installed_commit}}"
  branch="${MULMO_CONTROL_BRANCH:-${branch}}"
fi

write_status() {
  local status_value="$1"
  local latest_commit="$2"
  local detail="$3"
  cat > "${STATUS}" <<JSON
{
  "checkedAt": "$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)",
  "status": "${status_value}",
  "installedCommit": "${installed_commit}",
  "latestCommit": "${latest_commit}",
  "detail": "${detail}"
}
JSON
}

latest_commit="$(git ls-remote "${repo_url}" "refs/heads/${branch}" 2>/dev/null | /usr/bin/awk '{print $1}' || true)"
if [ -z "${latest_commit}" ]; then
  write_status "unknown" "unknown" "GitHubを確認できませんでした"
  exit 0
fi

if [ "${installed_commit}" = "${latest_commit}" ]; then
  write_status "current" "${latest_commit}" "最新版です"
  exit 0
fi

write_status "update" "${latest_commit}" "アプリ更新があります"

if [ "${1:-check}" != "apply" ]; then
  exit 0
fi

(
  {
    echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] self update requested"
    if [ -d "${source_dir}/.git" ]; then
      git -C "${source_dir}" fetch origin "${branch}"
      git -C "${source_dir}" checkout "${branch}"
      git -C "${source_dir}" pull --ff-only origin "${branch}"
    else
      mkdir -p "$(dirname "${source_dir}")"
      git clone "${repo_url}" "${source_dir}"
      git -C "${source_dir}" checkout "${branch}"
    fi

    osascript -e 'tell application "Mulmo Control" to quit' >/dev/null 2>&1 || true
    sleep 1
    "${source_dir}/install.sh"
    if ! open "/Applications/Mulmo Control.app" >/dev/null 2>&1; then
      "/Applications/Mulmo Control.app/Contents/MacOS/MulmoControl" >/dev/null 2>&1 &
    fi
  } >>"${LOG}" 2>&1
) &

echo "Mulmo Control: self update started"

#!/bin/zsh
set -u

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# 兄弟スクリプトは自分と同じディレクトリから呼ぶ（Issue #11）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
LOG="${LOG_DIR}/mulmoterminal-update.log"
NPM_CACHE="/private/tmp/npm-cache-mulmoterminal-swiftbar"

mkdir -p "${LOG_DIR}" "${NPM_CACHE}"

# 更新できなかった理由を、画面に出せる形で残す（Issue #46）。
REASONS="${LOG_DIR}/mulmo-update-reasons.txt"
say_reason() {
  printf '%s\t%s\n' "mulmoterminal" "$1" >> "${REASONS}"
}

NPM="$(command -v npm || true)"

if [ -z "${NPM}" ]; then
  echo "npm was not found" | tee -a "${LOG}"
  say_reason "npm が見つかりませんでした。Node.js を入れ直してください"
  exit 1
fi

echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] update requested" | tee -a "${LOG}"
echo "Before: $("${HOME}/.local/bin/mulmoterminal" --version 2>/dev/null || true)" | tee -a "${LOG}"

"${SCRIPT_DIR}/mulmoterminal-stop" | tee -a "${LOG}" || true

# tee に通すと終了コードが tee のものになり、npm の失敗が伝わらない。
# 黙って先へ進むと、更新できていないのにアプリが「更新しました」と報告する。
if ! MULMO_NPM="${NPM}" MULMO_NPM_CACHE="${NPM_CACHE}" \
  "${SCRIPT_DIR}/mulmo-npm-install" \
  "${HOME}/.local/share/mulmoterminal" mulmoterminal@latest >>"${LOG}" 2>&1; then
  "${SCRIPT_DIR}/mulmoterminal-start" | tee -a "${LOG}" || true
  echo "MulmoTerminal: npm install に失敗したので、更新できませんでした" | tee -a "${LOG}"
  say_reason "npm install に失敗しました。回線を確認して、もう一度お試しください"
  exit 1
fi

/bin/ln -sf \
  "${HOME}/.local/share/mulmoterminal/node_modules/.bin/mulmoterminal" \
  "${HOME}/.local/bin/mulmoterminal"

"${SCRIPT_DIR}/mulmoterminal-check-update" | tee -a "${LOG}" || true
"${SCRIPT_DIR}/mulmoterminal-start" | tee -a "${LOG}" || true

echo "After: $("${HOME}/.local/bin/mulmoterminal" --version 2>/dev/null || true)" | tee -a "${LOG}"
echo "Open: http://localhost:34567" | tee -a "${LOG}"

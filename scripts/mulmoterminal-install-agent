#!/bin/zsh
set -eu

# LaunchAgent の定義ファイルを書く（Issue #12）。
#
# 以前は install.sh の中のヒアドキュメントだけがこれを作っていた。つまり
# ターミナルで install.sh を叩いた人しか常駐を有効にできず、「zip を
# Applications にドラッグするだけ」というゴール（#15）と噛み合わなかった。
#
# 起動を押したときにアプリからも呼べるよう、独立した script にしてある。
# install.sh もこれを呼ぶので、定義は1箇所しかない。

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SCRIPT_DIR}/mulmoterminal-agent-env"

# plist から起動される本体。自分の隣にあるものを指す。
#
# アプリに同梱された写しから呼ばれればアプリの中を、~/.local/bin の写しから
# 呼ばれれば ~/.local/bin を指す。どちらの経路でも、生成した本人と対になる
# launcher が動く。install.sh を通っていない Mac でも成立するのが要点。
LAUNCHER="${SCRIPT_DIR}/start-mulmoterminal.sh"
if [ ! -x "${LAUNCHER}" ]; then
  echo "起動用のスクリプトが見つかりません: ${LAUNCHER}" >&2
  exit 1
fi

# 呼び出し側が場所を知っているならそれを優先する。
# install.sh は app-info.env をこのあとで書くので、初回インストールで
# MULMOCLAUDE_DIR=... を渡された場合、ファイルからは読めない。
OVERRIDE_DIR="${MULMO_CONTROL_MULMOCLAUDE_DIR:-}"

# 設定は shell として実行せず、許可したキーの値だけを読む（Issue #67）。
CONFIG_DIR="$("${SCRIPT_DIR}/mulmo-config-get" MULMO_CONTROL_MULMOCLAUDE_DIR)"
MULMOCLAUDE_DIR="${OVERRIDE_DIR:-${CONFIG_DIR:-${HOME}/mulmoclaude}}"

# LaunchAgent の作業ディレクトリは実在しないと起動そのものが失敗する。
# MulmoClaude を入れていない人もいるので、無ければ $HOME に逃がす。
WORK_DIR="${MULMOCLAUDE_DIR}"
[ -d "${WORK_DIR}" ] || WORK_DIR="${HOME}"

LOCAL_BIN="${HOME}/.local/bin"
CLAUDE_BIN="$(command -v claude || echo "${LOCAL_BIN}/claude")"
CODEX_BIN="$(command -v codex || echo "${LOCAL_BIN}/codex")"

mkdir -p "$(dirname "${MULMO_AGENT_PLIST}")" "${MULMO_AGENT_LOG_DIR}"

# 古いラベルで入っているものを片付ける（Issue #7）。
#
# 放っておくと、古い定義と新しい定義の2つが同じポートを取り合う。片方は必ず
# 「Port is already in use」で落ち、KeepAlive がそれを異常終了とみなして
# 蘇生し続ける。ラベルを変えるときは、消すところまでが1組。
#
# bootout は入っていなければエラーを返すが、それは「もう無い」ということなので
# 無視してよい。plist を消すのは bootout のあと（先に消すと launchd から
# 外せなくなる）。
for legacy in ${=MULMO_AGENT_LEGACY_LABELS}; do
  legacy_plist="${HOME}/Library/LaunchAgents/${legacy}.plist"
  [ -f "${legacy_plist}" ] || continue
  /bin/launchctl bootout "${MULMO_AGENT_DOMAIN}/${legacy}" 2>/dev/null || true
  rm -f "${legacy_plist}"
  echo "古い LaunchAgent を外しました: ${legacy}"
done

# 値に & や < が入っても壊れないよう、XML として退避してから埋める。
xml_escape() {
  printf '%s' "$1" | /usr/bin/sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

cat > "${MULMO_AGENT_PLIST}" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(xml_escape "${MULMO_AGENT_LABEL}")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "${LAUNCHER}")</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$(xml_escape "${WORK_DIR}")</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(xml_escape "${LOCAL_BIN}"):/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PORT</key>
    <string>$(xml_escape "${MULMO_AGENT_PORT}")</string>
    <key>MULMOTERMINAL_HOST</key>
    <string>$(xml_escape "${MULMO_AGENT_HOST}")</string>
    <key>CLAUDE_CWD</key>
    <string>$(xml_escape "${WORK_DIR}")</string>
    <key>CLAUDE_BIN</key>
    <string>$(xml_escape "${CLAUDE_BIN}")</string>
    <key>CODEX_BIN</key>
    <string>$(xml_escape "${CODEX_BIN}")</string>
    <key>MULMOTERMINAL_NO_UPDATE_CHECK</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>$(xml_escape "${MULMO_AGENT_LOG_DIR}")/host.log</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "${MULMO_AGENT_LOG_DIR}")/host-error.log</string>
</dict>
</plist>
PLIST

/usr/bin/plutil -lint "${MULMO_AGENT_PLIST}" >/dev/null || {
  echo "生成した plist が壊れています: ${MULMO_AGENT_PLIST}" >&2
  exit 1
}

echo "LaunchAgent: ${MULMO_AGENT_PLIST}"

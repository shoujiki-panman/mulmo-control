#!/bin/zsh
set -eu

# app-info.env を shell として実行せずに読む（Issue #67）。
#
# これまでは各スクリプトが `. "${CONFIG}"` / `source "${CONFIG}"` で読んでいた。
# 設定ファイルを shell code として実行しているので、そこに `touch ...` や
# `$(...)` や backtick が混ざれば、読んだ側の権限でそのまま走る。設定ファイルは
# データなので、許可したキーの値だけを取り出す。
#
# 使い方:
#   MC_DIR="$("${SCRIPT_DIR}/mulmo-config-get" MULMO_CONTROL_MULMOCLAUDE_DIR)"
#
# 値が無い・キーが許可外・ファイルが無い場合は、何も出さずに 0 で終わる。
# 呼ぶ側は `${VALUE:-既定値}` で受ける。エラーにしないのは、設定ファイルは
# 「無いのが普通」の場面があるため（初回インストールの途中など）。
#
# eval は使わない。使えば結局 shell code として実行することになる。

KEY="${1:-}"
FILE="${MULMO_CONFIG_FILE:-${HOME}/Library/Application Support/Mulmo Control/app-info.env}"

# 許可したキー以外は読まない。未知のキーは黙って無視する。
case "${KEY}" in
  MULMO_CONTROL_REPO_URL|MULMO_CONTROL_SOURCE_DIR|MULMO_CONTROL_INSTALLED_COMMIT|MULMO_CONTROL_BRANCH|MULMO_CONTROL_MULMOCLAUDE_DIR) ;;
  *) exit 0 ;;
esac

[ -f "${FILE}" ] || exit 0

# KEY= で始まる行だけを拾う。それ以外の行は形に関わらず捨てるので、
# 設定ファイルに何が書かれていても実行されない。
# 同じキーが複数あれば最後の行が勝つ（source と同じ挙動）。
raw=""
found=0
while IFS= read -r line || [ -n "${line}" ]; do
  case "${line}" in
    "${KEY}="*)
      raw="${line#${KEY}=}"
      found=1
      ;;
  esac
done < "${FILE}"

[ "${found}" = "1" ] || exit 0

# 引用符を外す。install.sh は ' で囲み、値の中の ' は '\'' に直して書く。
case "${raw}" in
  \'*\')
    raw="${raw#\'}"
    raw="${raw%\'}"
    raw="$(printf '%s' "${raw}" | /usr/bin/sed "s/'\\\\''/'/g")"
    ;;
  \"*\")
    raw="${raw#\"}"
    raw="${raw%\"}"
    ;;
esac

# コマンド置換や backtick を含む値は返さない。
#
# ここまで来た値は一度も実行されていないので、そのまま返しても走らない。
# ただし受け取った側が別の場所で展開する経路まで面倒は見られないので、
# 明らかに実行を狙った形は入口で落とす。
case "${raw}" in
  *'$('*|*'`'*) exit 0 ;;
esac

printf '%s\n' "${raw}"

#!/bin/zsh
set -u

# 登録をはずす（Issue #152）。
#
#   使い方: mulmo-project-remove <プロジェクト名>
#
# **はずす前に止める。** 一覧から消してしまうと、動いているセッションを止める
# 口がどこにも無くなり、次にログアウトするまで残り続ける。止めるのは控えた
# pid のものだけなので、人が手で開いたセッションは巻き込まない。
#
# projects.json は JSON として読み、同じフォルダの一時ファイル経由で入れ替える。

PATH="${HOME}/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_SUPPORT="${HOME}/Library/Application Support/Mulmo Control"
CONFIG="${APP_SUPPORT}/projects.json"
LOG_DIR="${HOME}/Library/Logs/Mulmo Control"
LOG="${LOG_DIR}/projects.log"

NAME="${1:-}"
mkdir -p "${LOG_DIR}"

if [ -z "${NAME}" ]; then
  echo "プロジェクト名を渡してください" | tee -a "${LOG}"
  exit 1
fi

"${SCRIPT_DIR}/mulmo-project-stop" "${NAME}" >>"${LOG}" 2>&1 || true

REMOVED="$(NAME="${NAME}" CONFIG="${CONFIG}" /usr/bin/python3 <<'PY'
import json, os, tempfile

config_path = os.environ["CONFIG"]
if not os.path.exists(config_path):
    print("no")
    raise SystemExit(0)
try:
    with open(config_path, encoding="utf-8") as handle:
        config = json.load(handle)
except (OSError, ValueError):
    config = None
# 読めない登録の上に書かない（add と同じ）。「登録されていません」と言うと、
# 消えたのだと読めてしまう。読めないことをそのまま言う。
if not isinstance(config, dict) or not isinstance(config.get("projects"), list):
    print("broken")
    raise SystemExit(0)
entries = config["projects"]

target = os.environ["NAME"]
kept = [e for e in entries if not (isinstance(e, dict) and e.get("name") == target)]
if len(kept) == len(entries):
    print("no")
    raise SystemExit(0)

config["projects"] = kept
directory = os.path.dirname(config_path)
handle = tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=directory, delete=False)
try:
    json.dump(config, handle, ensure_ascii=False, indent=2)
    handle.write("\n")
    handle.close()
    os.replace(handle.name, config_path)
except BaseException:
    os.unlink(handle.name)
    raise
print("yes")
PY
)" || {
  echo "はずせませんでした" | tee -a "${LOG}"
  exit 1
}

if [ "${REMOVED}" = "broken" ]; then
  echo "登録の読み取りに失敗しました: ${CONFIG}" | tee -a "${LOG}"
  exit 1
elif [ "${REMOVED}" = "yes" ]; then
  echo "「${NAME}」をはずしました" | tee -a "${LOG}"
else
  echo "「${NAME}」は登録されていません" | tee -a "${LOG}"
fi

"${SCRIPT_DIR}/mulmo-project-status" >/dev/null 2>&1 || true

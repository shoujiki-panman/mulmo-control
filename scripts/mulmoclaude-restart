#!/bin/zsh
set -u

# 兄弟スクリプトは自分と同じディレクトリから呼ぶ。アプリに同梱された
# Contents/Resources/scripts から実行されても、旧 SwiftBarTools から
# 実行されても、同じ組み合わせで動く（Issue #11）。
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# 停止から起動までを1本の処理として錠を取る（Issue #187）。
#
# ここで取らないと、`再起動` の連打が「停止 → 停止 → 起動 → 起動」に崩れて、
# 起動が2本並ぶ。`mulmoclaude-start` だけに錠を持たせても、こちら側の停止は
# 素通りするので防げない。
#
# 取れたら、持っていることを下に渡す。渡さないと start が自分で取ろうとして、
# 自分の錠に締め出される。
if [ -z "${MULMO_MC_LOCK_HELD:-}" ]; then
  if HOLDER="$("${SCRIPT_DIR}/mulmoclaude-lock" acquire $$ "再起動")"; then
    MULMO_MC_LOCK_HELD=1
    export MULMO_MC_LOCK_HELD
    trap '"${SCRIPT_DIR}/mulmoclaude-lock" release '"$$"' >/dev/null 2>&1 || true' EXIT INT TERM
  else
    BUSY_PID="${HOLDER%%	*}"
    BUSY_LABEL="${${HOLDER#*	}%%	*}"
    [ -n "${BUSY_LABEL}" ] || BUSY_LABEL="操作"
    echo "MulmoClaude: いま${BUSY_LABEL}の処理中です（pid ${BUSY_PID}）。終わるまで待ってください"
    exit 0
  fi
fi

"${SCRIPT_DIR}/mulmoclaude-stop" || true
sleep 1
"${SCRIPT_DIR}/mulmoclaude-start"
